    const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

    function getStoredBank() {
        const userCustom = GM_getValue('huayi_user_bank', null);
        if (userCustom && typeof userCustom === 'object') {
            return Object.assign({}, DEFAULT_BANK, userCustom);
        }
        return Object.assign({}, DEFAULT_BANK);
    }

    function saveCustomBank(newBank) {
        GM_setValue('huayi_user_bank', newBank);
    }

    function clean(t) {
        if (!t) return "";
        return String(t).trim()
            .replace(/^[0-9一二三四五六七八九十]+[\.\、\s\-\:\)）]+/g, '')
            .replace(/【.*?】|\\[.*?\\]|\\(.*?\\)|（.*?）/g, '')
            .replace(/\\(.*?分\\)|（.*?分）|\\[.*?分\\]/g, '')
            .replace(/单选题|多选题|判断题|本题答案[:：]/g, '')
            .replace(/[\\s\\t\\r\\n，。！？；：“”‘’（）《》\\.\\,\\?\\!\\、\\;\\'\\"]+/g, '');
    }

    function triggerClick(el) {
        if (!el) return;
        try { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch(e) {}
        ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach(evtType => {
            try {
                const evt = new MouseEvent(evtType, { bubbles: true, cancelable: true, view: window, buttons: 1 });
                el.dispatchEvent(evt);
            } catch(e) {}
        });
        try { el.click(); } catch(e) {}
        if (el.tagName.toLowerCase() === 'input' && (el.type === 'radio' || el.type === 'checkbox')) {
            el.checked = true;
            try { el.dispatchEvent(new Event('input', { bubbles: true })); } catch(e) {}
            try { el.dispatchEvent(new Event('change', { bubbles: true })); } catch(e) {}
        }
        const parentLabel = el.closest('label');
        if (parentLabel && parentLabel !== el) {
            try { parentLabel.click(); } catch(e) {}
        }
    }

    function highlightElement(el) {
        const target = el.closest('label') || el.closest('tr') || el.parentElement || el;
        if (target) {
            target.style.cssText += '; border: 2px solid #34a853 !important; background-color: rgba(52,168,83,0.2) !important; border-radius: 4px;';
        }
    }

    function getAllDocs() {
        const docs = [document];
        const iframes = document.querySelectorAll('iframe, frame');
        iframes.forEach(f => {
            try {
                const d = f.contentDocument || (f.contentWindow && f.contentWindow.document);
                if (d && !docs.includes(d)) docs.push(d);
            } catch(e) {}
        });
        return docs;
    }

    let isAnswering = false;

    async function executeAutoAnswer() {
        if (isAnswering) {
            alert('答题正在进行中，请耐心等待完成...');
            return;
        }

        const bank = getStoredBank();
        const allDocs = getAllDocs();
        let total = 0, matched = 0, clicked = 0;

        const btnAnswer = document.getElementById('hy-btn-answer');
        const statusEl = document.getElementById('hy-status-text');

        isAnswering = true;
        if (btnAnswer) {
            btnAnswer.style.background = '#e37400';
            btnAnswer.innerText = '⏳ 正在拟人答题中...';
        }

        for (const doc of allDocs) {
            const inputGroupMap = new Map();
            const allInputs = Array.from(doc.querySelectorAll("input[type='radio'], input[type='checkbox']"));

            allInputs.forEach(inp => {
                const name = inp.name || inp.id.replace(/_[A-Za-z0-9]+$/, '') || 'default_group';
                if (!inputGroupMap.has(name)) {
                    inputGroupMap.set(name, []);
                }
                inputGroupMap.get(name).push(inp);
            });

            const inputGroups = Array.from(inputGroupMap.values()).filter(g => g.length >= 2);
            total += inputGroups.length;

            const pageFullText = doc.body.innerText || '';
            const rawSegments = pageFullText.split(/本题答案[：:\s]*/);
            const segments = rawSegments.map(s => s.trim()).filter(s => s.length > 5);

            console.log(`📋 扫描到 ${inputGroups.length} 组选项，切分出 ${segments.length} 个独立题目段落`);

            for (let gIdx = 0; gIdx < inputGroups.length; gIdx++) {
                const inputs = inputGroups[gIdx];

                if (statusEl) {
                    statusEl.innerText = `正在作答第 ${gIdx + 1}/${inputGroups.length} 题...`;
                }

                let segText = "";
                if (gIdx < segments.length) {
                    segText = segments[gIdx];
                }

                const cleanSeg = clean(segText);

                let match = null;
                for (let k in bank) {
                    if (k.length >= 4) {
                        if (cleanSeg.includes(k) || k.includes(cleanSeg)) {
                            match = bank[k];
                            break;
                        }
                    }
                }

                if (!match) {
                    for (let k in bank) {
                        if (k.length >= 6) {
                            const subK = k.substring(0, Math.min(k.length, 10));
                            if (cleanSeg.includes(subK)) {
                                match = bank[k];
                                break;
                            }
                        }
                    }
                }

                if (match) {
                    matched++;
                    const rawAns = String(match.a).trim().toUpperCase();
                    const targetLetters = rawAns.split(/[|\,\s\、]/).map(x => x.trim()).filter(x => x.length > 0);

                    const targetIndices = [];
                    targetLetters.forEach(l => {
                        if (l === 'A') targetIndices.push(0);
                        else if (l === 'B') targetIndices.push(1);
                        else if (l === 'C') targetIndices.push(2);
                        else if (l === 'D') targetIndices.push(3);
                        else if (l === 'E') targetIndices.push(4);
                        else if (['Y', '对', '正确', '√', '是'].includes(l)) targetIndices.push(0);
                        else if (['N', '错', '错误', '×', '否'].includes(l)) targetIndices.push(1);
                    });

                    let ok = false;
                    const hasValueMatch = inputs.some(inp => targetLetters.includes((inp.value || '').toUpperCase()));

                    if (hasValueMatch) {
                        inputs.forEach(inp => {
                            const v = (inp.value || '').toUpperCase();
                            if (targetLetters.includes(v)) {
                                triggerClick(inp);
                                highlightElement(inp);
                                ok = true;
                            }
                        });
                    } else {
                        targetIndices.forEach(idx => {
                            if (idx >= 0 && idx < inputs.length) {
                                const targetInp = inputs[idx];
                                triggerClick(targetInp);
                                highlightElement(targetInp);
                                ok = true;
                            }
                        });
                    }

                    if (ok) {
                        clicked++;
                        console.log(`✅ 第 ${gIdx + 1} 题【${match.q}】➔ 勾选答案: [${rawAns}]`);
                    }
                } else {
                    console.warn(`⚠️ 第 ${gIdx + 1} 题未在题库中命中:`, cleanSeg.substring(0, 30));
                }

                // 每题间隔 10 秒倒计时 (最后一题不等待)
                if (gIdx < inputGroups.length - 1) {
                    for (let sec = 10; sec > 0; sec--) {
                        if (statusEl) {
                            statusEl.innerText = `第 ${gIdx + 1} 题完成，${sec} 秒后作答下一题...`;
                        }
                        await sleep(1000);
                    }
                }
            }
        }

        isAnswering = false;
        if (btnAnswer) {
            btnAnswer.style.background = '#1a73e8';
            btnAnswer.innerText = '🚀 一键全自动勾选';
        }
        if (statusEl) {
            statusEl.innerText = `🎉 答题完成: 共勾选 ${clicked} 题`;
        }

        alert(`⚡ 华医网答题助手：\n成功识别到 ${total} 题，题库精准命中 ${matched} 题，已按 10 秒间隔完成自动勾选 ${clicked} 题！`);
    }

    // 解析 Excel (.xlsx / .xls)
    function parseExcelFile(arrayBuffer) {
        if (typeof XLSX === 'undefined') {
            throw new Error('XLSX 解析库正在加载中，请稍候重试');
        }
        const workbook = XLSX.read(arrayBuffer, { type: 'array' });
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        const rows = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
        if (!rows || rows.length < 2) return {};

        let headerRowIdx = 0;
        let qIdx = -1, aIdx = -1;
        let optIndices = {};

        for (let r = 0; r < Math.min(5, rows.length); r++) {
            const row = rows[r] || [];
            row.forEach((cell, cIdx) => {
                const str = String(cell || '').trim();
                if (/题干|题目|question|试题/i.test(str)) qIdx = cIdx;
                else if (/正确答案|答案|answer|参考答案/i.test(str)) aIdx = cIdx;
                else if (/选项A/i.test(str)) optIndices['A'] = cIdx;
                else if (/选项B/i.test(str)) optIndices['B'] = cIdx;
                else if (/选项C/i.test(str)) optIndices['C'] = cIdx;
                else if (/选项D/i.test(str)) optIndices['D'] = cIdx;
                else if (/选项E/i.test(str)) optIndices['E'] = cIdx;
            });
            if (qIdx !== -1 && aIdx !== -1) {
                headerRowIdx = r;
                break;
            }
        }

        if (qIdx === -1) qIdx = 0;
        if (aIdx === -1) aIdx = 1;

        const newBank = {};
        for (let i = headerRowIdx + 1; i < rows.length; i++) {
            const row = rows[i];
            if (!row || row.length <= Math.max(qIdx, aIdx)) continue;
            const qRaw = String(row[qIdx] || '').trim();
            const aRaw = String(row[aIdx] || '').trim().toUpperCase();
            if (!qRaw || !aRaw) continue;
            if (/^【章节】|^【视频】/i.test(qRaw)) continue;

            const cQ = clean(qRaw);
            const optTexts = {};
            ['A', 'B', 'C', 'D', 'E'].forEach(l => {
                const col = optIndices[l];
                if (col !== undefined && row[col]) {
                    optTexts[l] = clean(String(row[col]));
                }
            });

            newBank[cQ] = {
                q: qRaw,
                a: aRaw,
                opts: optTexts
            };
        }
        return newBank;
    }

    // 悬浮控制面板
    function createFloatingPanel() {
        if (window.self !== window.top) return;
        if (document.getElementById('hy-auto-panel')) return;

        const panel = document.createElement('div');
        panel.id = 'hy-auto-panel';
        panel.innerHTML = `
            <div style="font-weight: bold; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 6px;">
                <span>🩺 华医网全科答题助手</span>
                <span id="hy-panel-close" style="cursor: pointer; font-size: 16px; opacity: 0.8;">✕</span>
            </div>
            <div style="font-size: 12px; color: #8ab4f8; margin-bottom: 10px;" id="hy-bank-count">
                📚 题库已就绪: ${Object.keys(getStoredBank()).length} 题
            </div>
            <button id="hy-btn-answer" style="width: 100%; background: #1a73e8; color: #fff; border: none; padding: 9px; border-radius: 6px; font-weight: bold; cursor: pointer; margin-bottom: 8px; font-size: 14px; box-shadow: 0 2px 6px rgba(0,0,0,0.2); transition: background 0.2s;">
                🚀 一键全自动勾选
            </button>
            <div style="display: flex; gap: 6px; margin-bottom: 8px;">
                <label style="flex: 1; text-align: center; background: #34a853; color: #fff; padding: 6px; border-radius: 4px; font-size: 12px; cursor: pointer; font-weight: 500;">
                    📂 导入 Excel (.xlsx)
                    <input type="file" id="hy-file-input" accept=".xlsx,.xls,.json,.txt,.csv" style="display: none;">
                </label>
                <button id="hy-btn-clear" style="flex: 1; background: #5f6368; color: #fff; border: none; border-radius: 4px; font-size: 12px; cursor: pointer;">
                    🗑️ 重置题库
                </button>
            </div>
            <div id="hy-status-text" style="font-size: 11px; color: #9aa0a6; text-align: center;">
                点击按钮后将每题间隔10秒自动勾选
            </div>
        `;

        panel.style.cssText = `
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 2147483647;
            background: rgba(32, 33, 36, 0.95);
            color: #fff;
            padding: 14px;
            border-radius: 10px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.4);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            width: 250px;
            user-select: none;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.1);
        `;

        document.body.appendChild(panel);

        document.getElementById('hy-btn-answer').onclick = executeAutoAnswer;
        document.getElementById('hy-panel-close').onclick = () => panel.style.display = 'none';
        
        document.getElementById('hy-file-input').onchange = function(e) {
            const file = e.target.files[0];
            if (!file) return;
            
            const fileName = file.name.toLowerCase();
            const reader = new FileReader();

            if (fileName.endsWith('.xlsx') || fileName.endsWith('.xls')) {
                reader.onload = function(evt) {
                    try {
                        const newBank = parseExcelFile(evt.target.result);
                        const count = Object.keys(newBank).length;
                        if (count > 0) {
                            const current = getStoredBank();
                            Object.assign(current, newBank);
                            saveCustomBank(current);
                            document.getElementById('hy-bank-count').innerText = `📚 题库已更新: ${Object.keys(current).length} 题`;
                            alert(`🎉 成功解析并导入 Excel 题库 ${count} 道考题！当前题库总数：${Object.keys(current).length} 题。`);
                        } else {
                            alert('未能从 Excel 中识别出有效题目，请检查表头是否包含「题目/题干」与「答案」列。');
                        }
                    } catch(err) {
                        alert('Excel 解析失败: ' + err.message);
                    }
                };
                reader.readAsArrayBuffer(file);
            }
        };

        document.getElementById('hy-btn-clear').onclick = function() {
            if (confirm('确定恢复为默认内置题库吗？')) {
                saveCustomBank(null);
                document.getElementById('hy-bank-count').innerText = `📚 题库已就绪: ${Object.keys(DEFAULT_BANK).length} 题`;
                alert('已恢复为默认题库！');
            }
        };
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        createFloatingPanel();
    } else {
        window.addEventListener('DOMContentLoaded', createFloatingPanel);
    }
    setTimeout(createFloatingPanel, 1500);

})();
